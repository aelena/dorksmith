{
  "name": "contact-pages / domain (full)",
  "input": "example.com",
  "inputType": "domain",
  "intent": "contact-pages",
  "options": {
    "fileTypes": [
      "pdf",
      "docx"
    ],
    "excludeTerms": [
      "jobs",
      "privacy policy"
    ],
    "after": "2024-01-01",
    "before": "2024-12-31",
    "maxVariants": 12,
    "organization": "Example Corp",
    "location": "Madrid",
    "role": "CTO",
    "displayName": "Alice Smith"
  },
  "expected": [
    {
      "id": "cp-domain-contact",
      "query": "site:example.com (intitle:contact OR inurl:contact OR intitle:\"contact us\") -jobs -\"privacy policy\""
    },
    {
      "id": "cp-domain-emails",
      "query": "site:example.com \"@example.com\" -jobs -\"privacy policy\""
    },
    {
      "id": "cp-domain-about",
      "query": "site:example.com (inurl:about OR inurl:team OR inurl:people OR inurl:staff OR intitle:about) -jobs -\"privacy policy\""
    },
    {
      "id": "cp-domain-offsite",
      "query": "\"@example.com\" -site:example.com -jobs -\"privacy policy\""
    },
    {
      "id": "cp-domain-press",
      "query": "site:example.com (intitle:press OR inurl:press OR inurl:media OR inurl:newsroom) -jobs -\"privacy policy\""
    }
  ],
  "expectedContains": []
}
