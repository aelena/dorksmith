{
  "name": "presentations-reports / domain (full)",
  "input": "example.com",
  "inputType": "domain",
  "intent": "presentations-reports",
  "options": {
    "fileTypes": [
      "pdf",
      "docx"
    ],
    "excludeTerms": [
      "jobs",
      "privacy policy"
    ],
    "after": "2024-01-01",
    "before": "2024-12-31",
    "maxVariants": 12,
    "organization": "Example Corp",
    "location": "Madrid",
    "role": "CTO",
    "displayName": "Alice Smith"
  },
  "expected": [
    {
      "id": "pr-domain-slides",
      "query": "site:example.com (filetype:pptx OR filetype:ppt) -jobs -\"privacy policy\""
    },
    {
      "id": "pr-domain-reports",
      "query": "site:example.com filetype:pdf (intitle:report OR intitle:\"annual report\" OR intitle:whitepaper OR intitle:overview) -jobs -\"privacy policy\""
    },
    {
      "id": "pr-domain-slide-sites",
      "query": "\"example\" (site:slideshare.net OR site:speakerdeck.com) -jobs -\"privacy policy\""
    },
    {
      "id": "pr-domain-doc-sites",
      "query": "\"example\" (site:scribd.com OR site:issuu.com OR site:docdroid.net) -jobs -\"privacy policy\""
    },
    {
      "id": "pr-domain-offsite",
      "query": "\"example.com\" (filetype:pptx OR filetype:pdf) -site:example.com -jobs -\"privacy policy\""
    }
  ],
  "expectedContains": []
}
