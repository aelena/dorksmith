    {
      "id": "sp-domain-linkedin",
      "query": "\"example\" site:linkedin.com/in -jobs -\"privacy policy\""
    },
    {
      "id": "sp-domain-emails",
      "query": "\"@example.com\" -site:example.com -jobs -\"privacy policy\""
    },
    {
      "id": "sp-domain-platforms",
      "query": "\"example\" (site:linkedin.com OR site:xing.com OR site:github.com OR site:x.com) -jobs -\"privacy policy\""
    },
    {
      "id": "sp-domain-titles",
      "query": "site:example.com (\"head of\" OR director OR manager OR engineer OR \"chief\") -jobs -\"privacy policy\""
    }
  ],
  "expectedContains": []
}
