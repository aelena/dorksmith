{
  "name": "public-documents / domain (full)",
  "input": "example.com",
  "inputType": "domain",
  "intent": "public-documents",
  "options": {
    "fileTypes": [
      "pdf",
      "docx"
    ],
    "excludeTerms": [
      "jobs",
      "privacy policy"
    ],
    "after": "2024-01-01",
    "before": "2024-12-31",
    "maxVariants": 12,
    "organization": "Example Corp",
    "location": "Madrid",
    "role": "CTO",
    "displayName": "Alice Smith"
  },
  "expected": [
    {
      "id": "pd-domain-balanced",
      "query": "site:example.com (filetype:pdf OR filetype:docx) -jobs -\u0022privacy policy\u0022"
    },
    {
      "id": "pd-domain-titles",
      "query": "site:example.com (filetype:pdf OR filetype:docx) (intitle:report OR intitle:policy OR intitle:presentation OR intitle:\u0022annual report\u0022) -jobs -\u0022privacy policy\u0022"
    },
    {
      "id": "pd-domain-recent",
      "query": "site:example.com (filetype:pdf OR filetype:docx) after:2024-01-01 before:2024-12-31 -jobs -\u0022privacy policy\u0022"
    },
    {
      "id": "pd-domain-sheets",
      "query": "site:example.com (filetype:xlsx OR filetype:xls OR filetype:csv) -jobs -\u0022privacy policy\u0022"
    },
    {
      "id": "pd-domain-first",
      "query": "site:example.com filetype:pdf -jobs -\u0022privacy policy\u0022"
    },
    {
      "id": "pd-domain-offsite",
      "query": "\u0022example.com\u0022 (filetype:pdf OR filetype:docx) -site:example.com -jobs -\u0022privacy policy\u0022"
    },
    {
      "id": "pd-domain-slides",
      "query": "site:example.com (filetype:pptx OR filetype:ppt) -jobs -\u0022privacy policy\u0022"
    }
  ],
  "expectedContains": []
}
