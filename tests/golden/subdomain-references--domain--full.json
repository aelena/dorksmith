    {
      "id": "sr-environments",
      "query": "site:*.example.com (inurl:dev OR inurl:staging OR inurl:test OR inurl:uat OR inurl:api OR inurl:admin OR inurl:portal) -inurl:www -jobs -\u0022privacy policy\u0022"
