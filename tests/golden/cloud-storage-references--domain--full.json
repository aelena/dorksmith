{
  "name": "cloud-storage-references / domain (full)",
  "input": "example.com",
  "inputType": "domain",
  "intent": "cloud-storage-references",
  "options": {
    "fileTypes": [
      "pdf",
      "docx"
    ],
    "excludeTerms": [
      "jobs",
      "privacy policy"
    ],
    "after": "2024-01-01",
    "before": "2024-12-31",
    "maxVariants": 12,
    "organization": "Example Corp",
    "location": "Madrid",
    "role": "CTO",
    "displayName": "Alice Smith"
  },
  "expected": [
    {
      "id": "cs-domain-all",
      "query": "\"example\" (site:s3.amazonaws.com OR site:blob.core.windows.net OR site:storage.googleapis.com) -jobs -\"privacy policy\""
    },
    {
      "id": "cs-domain-s3",
      "query": "\"example\" site:s3.amazonaws.com -jobs -\"privacy policy\""
    },
    {
      "id": "cs-domain-azure",
      "query": "\"example\" site:blob.core.windows.net -jobs -\"privacy policy\""
    },
    {
      "id": "cs-domain-gcs",
      "query": "\"example\" site:storage.googleapis.com -jobs -\"privacy policy\""
    },
    {
      "id": "cs-domain-others",
      "query": "\"example\" (site:digitaloceanspaces.com OR site:r2.dev OR site:backblazeb2.com OR site:wasabisys.com) -jobs -\"privacy policy\""
    },
    {
      "id": "cs-domain-links",
      "query": "\"example.com\" (inurl:s3.amazonaws.com OR inurl:blob.core.windows.net OR inurl:storage.googleapis.com) -site:example.com -jobs -\"privacy policy\""
    }
  ],
  "expectedContains": []
}
