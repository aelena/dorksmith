{
  "name": "dorksmith",
  "version": "0.1.0",
  "description": "Deterministic search-dork generator and OSINT query workbench engine. Catalog-driven, zero dependencies, runs in browsers and Node.",
  "license": "MIT",
  "author": "aelena",
  "repository": { "type": "git", "url": "git+https://github.com/aelena/dorksmith.git", "directory": "packages/dorksmith-js" },
  "homepage": "https://github.com/aelena/dorksmith/tree/main/packages/dorksmith-js#readme",
  "bugs": "https://github.com/aelena/dorksmith/issues",
  "keywords": ["osint", "socmint", "google-dorks", "search-operators", "dork", "security", "deterministic"],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./catalogs": { "types": "./dist/catalogs.generated.d.ts", "import": "./dist/catalogs.generated.js" },
    "./package.json": "./package.json"
  },
  "bin": { "dorksmith": "./dist/cli.js" },
  "files": ["dist", "catalogs", "README.md", "LICENSE"],
  "sideEffects": false,
  "engines": { "node": ">=20" },
  "scripts": {
    "sync-catalogs": "node scripts/sync-catalogs.mjs",
    "check-catalogs": "node scripts/sync-catalogs.mjs --check",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/golden.test.mjs test/unit.test.mjs",
    "prepack": "npm run check-catalogs && npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "typescript": "^5.6.2"
  }
}
