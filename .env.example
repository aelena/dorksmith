# Copy to .env next to compose.yaml. Never commit .env.

# Required for stable HMAC client keys across restarts (any long random string).
# Generate one:  openssl rand -hex 32
IP_HMAC_SECRET=db713bb3912848148189a6427a23c0cd65f73a51517c55b38136702ba9e43888

# Hmac | Raw | None. Defaults: None for the local compose.yaml (single user, nothing stored),
# Hmac for compose.prod.yaml. Uncomment to force a mode in both.
#IP_LOGGING_MODE=Hmac

RATE_LIMIT_ENABLED=true
RATE_LIMIT_PERMIT_LIMIT=25
RATE_LIMIT_WINDOW_MINUTES=60

SEARCH_LOG_RETENTION_DAYS=30

MAX_QUERY_LENGTH=500
MAX_VARIANTS=12

# Comma separated origins allowed to call the API cross-origin. Empty = same-origin only.
CORS_ALLOWED_ORIGINS=

# Host port for the web container (7077 by default so it does not collide with the usual 8080).
WEB_PORT=7077
