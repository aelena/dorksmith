# Copy to .env next to compose.yaml. Never commit .env.

# Required for stable HMAC client keys across restarts (any long random string).
# Generate one:  openssl rand -hex 32
IP_HMAC_SECRET=

# Hmac (default, recommended) | Raw | None
IP_LOGGING_MODE=Hmac

RATE_LIMIT_ENABLED=true
RATE_LIMIT_PERMIT_LIMIT=25
RATE_LIMIT_WINDOW_MINUTES=60

SEARCH_LOG_RETENTION_DAYS=30

MAX_QUERY_LENGTH=500
MAX_VARIANTS=12

# Comma separated origins allowed to call the API cross-origin. Empty = same-origin only.
CORS_ALLOWED_ORIGINS=

# Host port for the web container.
WEB_PORT=8080
