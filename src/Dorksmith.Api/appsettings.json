{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "Catalogs": {
    "Path": "data"
  },
  "Web": {
    "ServeStatic": true,
    "Path": "web",
    "CorsAllowedOrigins": []
  },
  "Generation": {
    "MaxQueryLength": 500,
    "MaxVariants": 12,
    "DefaultVariants": 6,
    "MaxExcludeTerms": 20,
    "MaxFileTypes": 10,
    "SupportedEngines": [ "google" ]
  },
  "RateLimiting": {
    "Enabled": true,
    "PermitLimit": 25,
    "WindowMinutes": 60,
    "QueueLimit": 0
  },
  "SearchLog": {
    "Enabled": true,
    "RetentionDays": 30,
    "SqlitePath": "state/dorksmith.db",
    "CleanupIntervalMinutes": 60
  },
  "Privacy": {
    "IpLoggingMode": "Hmac",
    "IpHmacSecret": null
  },
  "Proxy": {
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "UsernameSearch": {
    "Enabled": true,
    "MaxUsernameLength": 100,
    "MaxPlatforms": 100,
    "DefaultPlatforms": 30
  }
}
