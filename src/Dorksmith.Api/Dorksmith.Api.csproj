<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Dorksmith.Api</RootNamespace>
    <AssemblyName>Dorksmith.Api</AssemblyName>
    <UserSecretsId>dorksmith-api</UserSecretsId>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.31" />
    <!-- Explicit: Microsoft.Data.Sqlite 8.x pins SQLitePCLRaw 2.1.6, which carries GHSA-2m69-gcr7-jv3q. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Logging\Migrations\*.sql" />
  </ItemGroup>

</Project>
