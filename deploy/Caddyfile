{$DORKSMITH_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# nginx (web) serves the SPA and proxies /api and /health to the API container.
	reverse_proxy web:8080 {
		header_up X-Real-IP {remote_host}
	}
}
